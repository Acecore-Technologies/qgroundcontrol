# Checks the feed catalogue compiled into QGroundControl as the built-in one, GEOZONE_FEEDS_FILE: a catalogue which
# can't be read would build, then start without any feed. It checks what makes GeoZoneFeedCatalogue::parse() refuse a
# catalogue or leave an entry out by its structure: the JSON, the fileType and version, the lists of feeds and
# services, and the id, name, enabled and addresses of their entries. The tests check the rest of the built-in file.
#   geozone_check_feeds_file(<file>) after including this file, or
#   cmake -DFEEDS_FILE=<file> -P GeoZoneFeedsCheck.cmake

function(geozone_check_feeds_file file)
    if(NOT EXISTS "${file}" OR IS_DIRECTORY "${file}")
        message(FATAL_ERROR "The geozone feed catalogue ${file} (GEOZONE_FEEDS_FILE) doesn't exist.")
    endif()
    # Like GeoZoneFeedCatalogue::parse(), without the byte order mark some editors write
    file(READ "${file}" start LIMIT 3 HEX)
    if(start STREQUAL "efbbbf")
        file(READ "${file}" content OFFSET 3)
    else()
        file(READ "${file}" content)
    endif()
    set(prefix "The geozone feed catalogue ${file} (GEOZONE_FEEDS_FILE) can't be used")

    string(JSON rootType ERROR_VARIABLE error TYPE "${content}")
    if(error)
        message(FATAL_ERROR "${prefix}: invalid JSON, ${error}.")
    endif()
    if(NOT rootType STREQUAL "OBJECT")
        message(FATAL_ERROR "${prefix}: the document isn't a JSON object.")
    endif()

    string(JSON fileTypeType ERROR_VARIABLE error TYPE "${content}" fileType)
    if(NOT error)
        string(JSON fileType GET "${content}" fileType)
        if(NOT fileTypeType STREQUAL "STRING" OR NOT fileType STREQUAL "GeoZoneFeeds")
            message(FATAL_ERROR "${prefix}: its fileType is ${fileType} rather than GeoZoneFeeds.")
        endif()
    endif()
    string(JSON versionType ERROR_VARIABLE error TYPE "${content}" version)
    if(NOT error)
        string(JSON version GET "${content}" version)
        if(NOT versionType STREQUAL "NUMBER" OR NOT version MATCHES "^1(\\.0+)?$")
            message(FATAL_ERROR "${prefix}: its version is ${version}, this QGroundControl reads version 1.")
        endif()
    endif()

    set(lists 0)
    foreach(list feeds services)
        string(JSON listType ERROR_VARIABLE error TYPE "${content}" ${list})
        if(error)
            continue()
        endif()
        math(EXPR lists "${lists} + 1")
        if(NOT listType STREQUAL "ARRAY")
            message(FATAL_ERROR "${prefix}: its ${list} must be a list.")
        endif()
        string(JSON count LENGTH "${content}" ${list})
        if(count EQUAL 0)
            continue()
        endif()
        set(ids "")
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            math(EXPR number "${index} + 1")
            string(JSON entryType TYPE "${content}" ${list} ${index})
            if(NOT entryType STREQUAL "OBJECT")
                message(FATAL_ERROR "${prefix}: entry ${number} of its ${list} isn't an object.")
            endif()
            geozone_feeds_text(id "${content}" ${list} ${index} id)
            if(id STREQUAL "")
                message(FATAL_ERROR "${prefix}: entry ${number} of its ${list} has no id.")
            endif()
            if(id IN_LIST ids)
                message(FATAL_ERROR "${prefix}: ${id} is listed twice in its ${list}.")
            endif()
            list(APPEND ids "${id}")

            string(JSON enabledType ERROR_VARIABLE error TYPE "${content}" ${list} ${index} enabled)
            if(NOT error)
                if(NOT enabledType STREQUAL "BOOLEAN")
                    message(FATAL_ERROR "${prefix}: the enabled of ${id} must be true or false, without quotes.")
                endif()
                string(JSON enabled GET "${content}" ${list} ${index} enabled)
                if(NOT enabled)
                    continue()
                endif()
            endif()
            geozone_feeds_text(name "${content}" ${list} ${index} name)
            if(name STREQUAL "")
                message(FATAL_ERROR "${prefix}: ${id} has no name.")
            endif()
            if(list STREQUAL "feeds")
                geozone_feeds_text(url "${content}" ${list} ${index} url)
                geozone_feeds_text(areaUrl "${content}" ${list} ${index} areaUrl)
                if(url STREQUAL "" AND areaUrl STREQUAL "")
                    message(FATAL_ERROR "${prefix}: ${id} has neither a url nor an areaUrl.")
                endif()
                foreach(address IN ITEMS "${url}" "${areaUrl}")
                    if(NOT address STREQUAL "" AND NOT address MATCHES "^(https?://[^/]|file:)")
                        message(FATAL_ERROR "${prefix}: the address ${address} of ${id} isn't an https, http or file address.")
                    endif()
                endforeach()
            endif()
        endforeach()
    endforeach()
    if(lists EQUAL 0)
        message(FATAL_ERROR "${prefix}: it has no feeds or services.")
    endif()
endfunction()

# Sets result to the text member of an entry, empty when it has none or it isn't a text
function(geozone_feeds_text result content list index member)
    set(${result} "" PARENT_SCOPE)
    string(JSON type ERROR_VARIABLE error TYPE "${content}" ${list} ${index} ${member})
    if(NOT error AND type STREQUAL "STRING")
        string(JSON text GET "${content}" ${list} ${index} ${member})
        string(STRIP "${text}" text)
        set(${result} "${text}" PARENT_SCOPE)
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND FEEDS_FILE)
    geozone_check_feeds_file("${FEEDS_FILE}")
endif()
