# Checks that the stub of the QGroundControl.GeoZone QML module in src/GeoZone/Stub, which builds without geozones
# (QGC_DISABLE_GEOZONE) use, declares what the QML outside src/GeoZone uses of the module: its types, the properties set
# and signals handled on them, the members used through their ids and the members of its singletons. A hook added to
# that QML without its stub would otherwise only break the builds without geozones, at runtime.
#   cmake -DSOURCE_DIR=<source dir> -P GeoZoneStubCheck.cmake

if(NOT SOURCE_DIR)
    message(FATAL_ERROR "Usage: cmake -DSOURCE_DIR=<source dir> -P GeoZoneStubCheck.cmake")
endif()

set(stubDir "${SOURCE_DIR}/src/GeoZone/Stub")
file(READ "${stubDir}/CMakeLists.txt" stubList)
# Properties of the base types of the stubs (Item, QtObject, ToolStripAction), which the QML may set without the stub
# declaring them
set(baseProperties id anchors Layout x y z width height visible enabled opacity text)
set(errors "")
set(fileCount 0)
set(useCount 0)

# Sets result to TRUE when the stub of type declares member as a property, function or signal, or when there is no stub
# (reported as a missing type). The properties of the base types count unless the member belongs to a singleton.
function(stub_declares type member singleton result)
    set(${result} TRUE PARENT_SCOPE)
    set(file "${stubDir}/${type}.qml")
    if(NOT EXISTS "${file}" OR (NOT singleton AND member IN_LIST baseProperties))
        return()
    endif()
    file(READ "${file}" stub)
    if(NOT stub MATCHES "(property[ \t]+[A-Za-z0-9_<>.]+|function|signal)[ \t]+${member}[^A-Za-z0-9_]")
        set(${result} FALSE PARENT_SCOPE)
    endif()
endfunction()

# Sets result to the member an assignment refers to: the property, or for a handler like onFooChanged or onFoo, the
# property foo or the signal foo
function(assigned_member name result)
    if(name MATCHES "^on([A-Z])([A-Za-z0-9_]*)$")
        string(TOLOWER "${CMAKE_MATCH_1}" first)
        string(REGEX REPLACE "Changed$" "" name "${first}${CMAKE_MATCH_2}")
    endif()
    set(${result} "${name}" PARENT_SCOPE)
endfunction()

macro(check_type where type)
    math(EXPR useCount "${useCount} + 1")
    if(NOT EXISTS "${stubDir}/${type}.qml" OR NOT stubList MATCHES "[ \t\n]${type}\\.qml")
        list(APPEND errors "${where}: type ${type}")
    endif()
endmacro()

macro(check_member where type member singleton)
    math(EXPR useCount "${useCount} + 1")
    stub_declares(${type} ${member} ${singleton} declared)
    if(NOT declared)
        list(APPEND errors "${where}: ${type}.${member}")
    endif()
endmacro()

file(GLOB_RECURSE qmlFiles RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/src/*.qml")
list(FILTER qmlFiles EXCLUDE REGEX "^src/GeoZone/")
list(SORT qmlFiles)

foreach(qmlFile IN LISTS qmlFiles)
    file(READ "${SOURCE_DIR}/${qmlFile}" content)
    if(NOT content MATCHES "import[ \t]+QGroundControl\\.GeoZone[ \t\r]*\n")
        continue()
    endif()
    math(EXPR fileCount "${fileCount} + 1")

    # The lines as a list, without comments and the characters having a meaning in lists
    string(REPLACE "\\" "/" text "${content}")
    string(REGEX REPLACE "//[^\n]*" "" text "${text}")
    string(REPLACE ";" "<semicolon>" text "${text}")
    string(REPLACE "[" "(" text "${text}")
    string(REPLACE "]" ")" text "${text}")
    string(REPLACE "\n" ";" lines "${text}")

    # The blocks of the module's types: Type { assignments } on one line, or with the assignments on the lines below
    set(depth 0)
    set(blockType "")
    set(blockDepth 0)
    set(ids "")
    set(lineNumber 0)
    foreach(line IN LISTS lines)
        math(EXPR lineNumber "${lineNumber} + 1")
        set(where "${qmlFile}:${lineNumber}")
        set(opensBlock FALSE)
        if(blockType STREQUAL "" AND line MATCHES "(^|[^A-Za-z0-9_./])(GeoZone[A-Z][A-Za-z0-9_]*)[ \t]*{(.*)$")
            set(type "${CMAKE_MATCH_2}")
            set(rest "${CMAKE_MATCH_3}")
            check_type("${where}" ${type})
            if(rest MATCHES "^(.*)}")
                string(REGEX MATCHALL "({|<semicolon>)[ \t]*[A-Za-z_][A-Za-z0-9_.]*[ \t]*:" assignments "{${CMAKE_MATCH_1}")
                foreach(assignment IN LISTS assignments)
                    string(REGEX REPLACE "^({|<semicolon>)[ \t]*([A-Za-z_][A-Za-z0-9_]*).*$" "\\2" name "${assignment}")
                    assigned_member(${name} member)
                    check_member("${where}" ${type} ${member} FALSE)
                endforeach()
            else()
                set(blockType ${type})
                set(blockDepth ${depth})
                set(opensBlock TRUE)
            endif()
        elseif(NOT blockType STREQUAL "")
            math(EXPR innerDepth "${blockDepth} + 1")
            if(depth EQUAL innerDepth AND line MATCHES "^[ \t]*([A-Za-z_][A-Za-z0-9_]*)[A-Za-z0-9_.]*[ \t]*:[ \t]*([A-Za-z0-9_]*)")
                set(name ${CMAKE_MATCH_1})
                if(name STREQUAL "id")
                    list(APPEND ids "${CMAKE_MATCH_2}=${blockType}")
                endif()
                assigned_member(${name} member)
                check_member("${where}" ${blockType} ${member} FALSE)
            endif()
        endif()
        string(REGEX MATCHALL "{" opened "${line}")
        string(REGEX MATCHALL "}" closed "${line}")
        list(LENGTH opened openedCount)
        list(LENGTH closed closedCount)
        math(EXPR depth "${depth} + ${openedCount} - ${closedCount}")
        if(NOT opensBlock AND NOT blockType STREQUAL "" AND depth LESS_EQUAL blockDepth)
            set(blockType "")
        endif()
    endforeach()

    # The members used through the ids of the blocks, like overlay.confirmUpload()
    foreach(entry IN LISTS ids)
        string(REPLACE "=" ";" entry "${entry}")
        list(GET entry 0 id)
        list(GET entry 1 type)
        string(REGEX MATCHALL "[^A-Za-z0-9_.]${id}\\.[A-Za-z_][A-Za-z0-9_]*" uses "${text}")
        foreach(use IN LISTS uses)
            string(REGEX REPLACE "^.*\\.([A-Za-z_][A-Za-z0-9_]*)$" "\\1" member "${use}")
            check_member("${qmlFile}" ${type} ${member} FALSE)
        endforeach()
    endforeach()

    # The members of the singletons, like GeoZoneManager.settings.visible
    string(REGEX MATCHALL "[^A-Za-z0-9_./]GeoZone[A-Z][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+" uses "${text}")
    foreach(use IN LISTS uses)
        string(REGEX REPLACE "^[^G]+" "" use "${use}")
        string(REPLACE "." ";" members "${use}")
        list(POP_FRONT members type)
        check_type("${qmlFile}" ${type})
        foreach(member IN LISTS members)
            check_member("${qmlFile}" ${type} ${member} TRUE)
        endforeach()
    endforeach()
endforeach()

if(fileCount EQUAL 0)
    message(FATAL_ERROR "No QML in ${SOURCE_DIR}/src outside src/GeoZone imports QGroundControl.GeoZone")
endif()
if(errors)
    list(REMOVE_DUPLICATES errors)
    list(JOIN errors "\n  " missing)
    message(FATAL_ERROR "src/GeoZone/Stub, used by builds without geozones, lacks what this QML uses:\n  ${missing}")
endif()
message(STATUS "src/GeoZone/Stub declares the ${useCount} uses of the module in ${fileCount} QML files")
